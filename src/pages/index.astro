---
import Welcome from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';
import  Preloader  from '../components/Preloader.astro';
import FloatingBubbles from "../components/FloatingBubbles.astro";

import '../styles/global.css'



// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>
	<Preloader />
	<FloatingBubbles	 />
	

	<Welcome />

	
</Layout>
 <script>
	import AOS from 'aos';

	AOS.init({
  duration: 800,
  once: true,
  offset: 80,
  easing: 'ease-out',
});



  

  import ScrollReveal from "scrollreveal";

  const initScrollReveal = () => {
    const sr = ScrollReveal();

    // Configuración para la izquierda (más suave y detecta el inicio)
    sr.reveal(".izquierda", {
      duration: 3000,                      // Duración un poco mayor para suavidad
      distance: "25px",                    // Desplazamiento más corto y elegante
      origin: "left",
      easing: "cubic-bezier(0.5, 0, 0, 1)", // Curva de animación fluida
      viewFactor: 0.1,                     // Se dispara apenas entra un 10% en pantalla (ideal para el inicio)
      reset: false,
      cleanup: true
    });

    // Configuración para la derecha (más suave y detecta el inicio)
    sr.reveal(".derecha", {
      duration: 3000,
      distance: "25px",
      origin: "right",
      easing: "cubic-bezier(0.5, 0, 0, 1)",
      viewFactor: 0.1,
      reset: false,
      cleanup: true
    });
  };

  // Esperamos a que el preloader termine y el DOM esté completamente listo
  window.addEventListener("load", () => {
    setTimeout(() => {
      initScrollReveal();
    }, 800); // 400ms para asegurar que el preloader ya se haya desvanecido
  });

 </script>
